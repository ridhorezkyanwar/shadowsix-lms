# Local environment secrets. Only the placeholder template is tracked.
.env
.env.*
!.env.example
config.local.php

# .htaccess is tracked only for non-secret security rules.
# Never put hosting credentials or private environment values in it.

# Generated user uploads (keep upload protection file tracked)
uploads/*
!uploads/.htaccess
!uploads/materi/
!uploads/mapel/
uploads/materi/*
uploads/mapel/*

# Database exports/backups are private data; keep the schema-only shadowsix.sql tracked.
ridho10_shadowsix.sql
*_backup.sql
*backup*.sql
*_dump.sql
*dump*.sql
*.sql.gz
*.dump

# Local/generated files
*.log
.DS_Store
Thumbs.db
__filelist.txt
tmp_changed_files.txt
tmp_status.txt
